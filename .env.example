# JARVIS — example environment file
# ===================================================================
# EVERYTHING HERE IS OPTIONAL in the default (bridge) mode. JARVIS runs
# perfectly with an empty file — the bridge authenticates off your Claude Code
# login, and voice input and output both fall back to the browser's own speech.
# Copy this to .env.local, and add only what you actually want to change.
#
# The one line worth adding is ELEVENLABS_API_KEY, down in the BRIDGE section:
# it enables Scribe transcription. Prefer Voice Settings for DPAPI storage. The free tier is
# plenty for a demo. Never commit a real key.
#
# Two audiences read these variables:
#   - the BRIDGE (the Node server, bridge/server.mjs) reads the JARVIS_* and
#     ELEVENLABS_API_KEY variables from its shell environment.
#   - the FRONTEND (the Vite app) reads the VITE_* variables from .env.local.
# Only VITE_-prefixed values ever reach the browser.


# ===================================================================
# BRIDGE (the server) — read from the shell that runs `npm run bridge`
# ===================================================================
# These are shown with their defaults. Leave them unset to accept the default.

# Port the bridge listens on (WebSocket + a few HTTP endpoints). Default 8787.
# In npm start, the frontend broker inherits this shell variable too. When
# running the face in another shell, set it there or use VITE_BRIDGE_URL below.
# JARVIS_BRIDGE_PORT=8787

# The model the bridge asks Claude Code to run. Default claude-opus-5.
# JARVIS_MODEL=claude-opus-5

# Reasoning effort. Default medium.
# JARVIS_EFFORT=medium

# Optional initial provider/model preferences. AI Settings takes precedence
# once saved. Keys are accepted only through AI Settings, never this file.
# Providers: claude-agent (default), openrouter, openai, gemini.
# JARVIS_AI_PROVIDER=claude-agent
# FAST/DEEP use BALANCED when blank; each provider keeps its own mappings.
# JARVIS_OPENROUTER_BALANCED_MODEL=openrouter/free
# JARVIS_OPENAI_BALANCED_MODEL=
# JARVIS_GEMINI_BALANCED_MODEL=
# Equivalent JARVIS_<PROVIDER>_FAST_MODEL / _DEEP_MODEL are also supported.

# Allow effectful tools (send, tap, delete, install, pay). Off by default, so
# JARVIS can look at anything and change nothing. `npm run bridge:writes` sets
# this to 1 for you — read the decideTool gate in bridge/server.mjs first.
# JARVIS_ALLOW_WRITES=0

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# Local dev origins are already allowed; add others only if you serve the app
# from a different address. Default: none.
# JARVIS_ALLOWED_ORIGINS=

# Allow authenticated clients that send no Origin header (curl/native apps).
# This never disables token authentication or loopback binding.
# Off by default, because that is also what local malware looks like. Default 0.
# JARVIS_ALLOW_NO_ORIGIN=0

# Extra approved artifact directories, comma separated; must already exist.
# Default: only the private per-user JarvisAI bridge artifact directory.
# Home/temp/drive roots and UNC/device paths are rejected. Tools writing their
# images elsewhere need a narrow output folder explicitly approved here.
# JARVIS_FILE_ROOTS=

# Conservative authenticated concurrency budgets (integer values).
# JARVIS_MAX_SESSIONS=1
# JARVIS_MAX_HTTP=8
# JARVIS_MAX_PROXIES=6
# JARVIS_MAX_STT=1
# JARVIS_MAX_TTS=2
# JARVIS_REQUESTS_PER_MINUTE=120

# ElevenLabs voice id for the bridge's own speech endpoint. Default: George.
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs API key. Optional backend-only compatibility path. Prefer saving
# through Voice Settings (DPAPI outside the repository). It enables Scribe; without it, everything still works on
# the browser's own speech. If you already have an elevenlabs MCP server in
# ~/.claude.json, the bridge reads the key from there and you can leave this
# blank. Default: none.
# ELEVENLABS_API_KEY=


# ===================================================================
# FRONTEND (Vite) — put these in .env.local
# ===================================================================

# AI always uses the authenticated Node bridge. Configure OpenRouter through
# AI Settings (OpenRouter/OpenAI/Gemini); never put a permanent AI key in VITE_* variables.

# Optional local bridge address for the Node frontend broker, not a browser
# credential or a remote-host setting. Overrides its JARVIS_BRIDGE_PORT.
# Default: inherited JARVIS_BRIDGE_PORT, otherwise ws://127.0.0.1:8787.
# VITE_BRIDGE_URL=ws://localhost:8787

# Browser text-to-speech engine. System speech remains the default even with STT configured.
# Default system.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice running in the browser. Better sound, slower to start.
# VITE_TTS_ENGINE=system

# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bm_george.
# VITE_KOKORO_VOICE=bm_george

# Prefer the ElevenLabs voice from the browser when a key is available.
# Default false.
# VITE_USE_ELEVENLABS=false
